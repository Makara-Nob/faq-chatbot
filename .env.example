# Copy to .env and fill in.  .env must NEVER be committed (check .gitignore).
# JAVA: application.properties / application-prod.yml

ENV=dev                      # dev | staging | prod
DEBUG=false

# Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-key-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# dev:  sqlite:///./app.db
# prod: postgresql+psycopg://user:password@db-host:5432/faqbot
DATABASE_URL=sqlite:///./app.db

# First admin, created automatically at startup when both are set.
# Editing these does NOT change an admin that already exists - use
#   ./dev admin --username ... --reset-password
# Dev convenience. In production leave these blank, keep the secret in a
# secrets manager, and run scripts/create_admin.py as a deploy step.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMePassword123
SEED_ADMIN=true

CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60

# false = keyword engine (no API key needed)
# true  = the Claude + Chroma RAG pipeline
USE_RAG=false
ANTHROPIC_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=faq-chatbot
